# Copy to .env on the server and fill in secrets before install.sh.
# Image tags are pinned in images.yaml — keep both in sync.
# .env stays on the server. Do not commit it.

COMPOSE_PROJECT_NAME=homelab

# Docker images (from images.yaml)
IMAGE_CADDY=caddy:2.9.1-alpine
IMAGE_POSTGRES=postgres:17.5-alpine
IMAGE_REDIS=redis:7.4.2-alpine
IMAGE_MINIO=pgsty/silo:RELEASE.2026-11-12T00-00-00Z
IMAGE_GRAFANA=grafana/grafana:11.6.0
IMAGE_PROMETHEUS=prom/prometheus:v3.2.1
IMAGE_NODE_EXPORTER=prom/node-exporter:v1.9.0
IMAGE_CADVISOR=gcr.io/cadvisor/cadvisor:v0.51.0
IMAGE_LOKI=grafana/loki:3.4.2
IMAGE_PROMTAIL=grafana/promtail:3.4.2
IMAGE_PORTAINER=portainer/portainer-ce:2.27.1
IMAGE_UPTIME_KUMA=louislam/uptime-kuma:1.23.16

# Network
INFRA_NETWORK=infra

# Host paths. install.sh creates these directories.
# Add each app by hand under PROJECTS_PATH, for example ToDoApp or ToDoApp2Teste.
STORAGE_PATH=/srv/data
PROJECTS_PATH=/srv/projects
BACKUP_PATH=/srv/backups
# Directory on a disk that is not the NVMe. Leave empty to keep dumps only in BACKUP_PATH.
BACKUP_OFFSITE_PATH=
ENABLE_BACKUP_TIMER=false

# Public HTTPS. Leave false until a domain and a CGNAT check are done.
PUBLIC_HTTP=false
DOMAIN=localhost
ACME_EMAIL=admin@localhost
# internal uses Caddy's local CA. Set to acme when PUBLIC_HTTP=true.
CADDY_ISSUER=internal

# Leave empty to keep an existing Tailscale login unchanged.
TAILSCALE_AUTHKEY=

# Caddy
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_ADMIN_PORT=2019

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homelab
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# Prometheus
PROMETHEUS_PORT=9090

# Loki
LOKI_PORT=3100

# Portainer
PORTAINER_HTTP_PORT=9443
PORTAINER_EDGE_PORT=8000

# Uptime Kuma
UPTIME_KUMA_PORT=3001
